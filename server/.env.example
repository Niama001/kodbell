# Copy this file to .env and fill in your real values. Never commit .env.

# Your Postgres connection (matches what you'd plug into DBeaver)
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=your_postgres_password
PGDATABASE=kodbell

# Secret used to sign JWTs - make this a long random string
JWT_SECRET=change_this_to_a_long_random_string

PORT=4000
